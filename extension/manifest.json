{
  "manifest_version": 3,
  "name": "FluxDM",
  "version": "0.1.0",
  "description": "Download manager integration for FluxDM",
  "permissions": ["declarativeNetRequest", "downloads", "storage", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background/background.js" },
  "action": { "default_popup": "popup/popup.html", "default_icon": "icons/icon48.png" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content/content.js"] }]
}

# FluxDM — .editorconfig  (https://editorconfig.org)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,jsx,json,css,html,yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
# two trailing spaces are a hard line break in Markdown
trim_trailing_whitespace = false
